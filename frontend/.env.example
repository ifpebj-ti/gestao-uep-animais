# URL da API consumida pelo frontend.
#
# Ao subir o container, o docker-entrypoint.d/40-generate-api-config.sh usa
# "envsubst" para gravar este valor (e GOOGLE_CLIENT_ID) em js/config.js
# (window.__APP_CONFIG__), que o script.js lê para montar API_BASE e
# inicializar o botão "Continuar com Google". Se você mudar isto, precisa
# recriar o container do frontend (docker compose up --build frontend) para
# o novo valor ser aplicado — é gerado uma vez, na inicialização do nginx.
API_URL=http://localhost:3000

# Vem do .env.example da RAIZ via docker-compose.yml (frontend ->
# environment); deixe em branco aqui.
GOOGLE_CLIENT_ID=
