# URL da API consumida pelo frontend.
#
# Ao subir o container, o docker-entrypoint.d/40-generate-api-config.sh usa
# "envsubst" para gravar este valor em js/config.js (window.__APP_CONFIG__),
# que o script.js lê para montar API_BASE. Se você mudar isto, precisa
# recriar o container do frontend (docker compose up --build frontend) para
# o novo valor ser aplicado — é gerado uma vez, na inicialização do nginx.
API_URL=http://localhost:3000
