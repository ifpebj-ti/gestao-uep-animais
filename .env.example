# Variáveis globais / compartilhadas entre os serviços.
# Copie este arquivo para ".env" na raiz do projeto para customizar valores
# usados pelo docker-compose.yml (interpolação ${VAR} e injeção via
# "environment" nos serviços). Este é o único lugar onde a configuração de
# banco/portas deve ser editada quando o projeto roda via docker compose —
# backend/.env.example e frontend/.env.example guardam apenas configuração
# exclusiva de cada serviço, para não haver dois lugares dessincronizados.

# Banco de dados
DB_HOST=db
DB_PORT=5432
DB_NAME=gestao_uep
DB_USER=postgres
DB_PASSWORD=changeme

# Backend
BACKEND_PORT=3000

# Frontend
FRONTEND_PORT=8080
# URL da API que o navegador vai chamar (injetada no frontend em tempo de
# container, via envsubst, em js/config.js — ver frontend/.env.example)
API_URL=http://localhost:3000

# Data (Python)
DATA_SERVICE_PORT=5000
