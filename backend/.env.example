# Configuração exclusiva do backend.
#
# Ao rodar via "docker compose up", DB_HOST/DB_PORT/DB_NAME/DB_USER/
# DB_PASSWORD e BACKEND_PORT vêm do .env.example da RAIZ do projeto
# (ver docker-compose.yml -> backend -> environment). Não repita esses
# valores aqui para não correr o risco de os dois arquivos ficarem
# dessincronizados.
#
# Só precisa preencher DB_* aqui se for rodar o backend sozinho, fora do
# docker compose (ex.: "cd backend && npm run dev" com um Postgres local):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gestao_uep
# DB_USER=postgres
# DB_PASSWORD=changeme
# BACKEND_PORT=3000

# Auth
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Contas de demonstração criadas automaticamente pela migration (uma por
# perfil), para toda a equipe ter os mesmos logins de teste em qualquer
# máquina. Senha em texto puro aqui é só para dev — nunca use isto num
# ambiente de produção de verdade (defina SEED_DEMO_USERS=false lá e troque
# a senha do admin no primeiro login).
#
#   Perfil       E-mail                        Senha padrão
#   ADMIN        admin@ifpe.edu.br             admin123
#   PROFESSOR    professor@ifpe.edu.br         professor123
#   TECNICO      tecnico@ifpe.edu.br           tecnico123
#   ESTAGIARIO   estagiario@ifpe.edu.br        estagiario123
#   ALUNO        aluno@ifpe.edu.br             aluno123
#
# SEED_DEMO_USERS=false
SEED_ADMIN_EMAIL=admin@ifpe.edu.br
SEED_ADMIN_PASSWORD=admin123
SEED_PROFESSOR_EMAIL=professor@ifpe.edu.br
SEED_PROFESSOR_PASSWORD=professor123
SEED_TECNICO_EMAIL=tecnico@ifpe.edu.br
SEED_TECNICO_PASSWORD=tecnico123
SEED_ESTAGIARIO_EMAIL=estagiario@ifpe.edu.br
SEED_ESTAGIARIO_PASSWORD=estagiario123
SEED_ALUNO_EMAIL=aluno@ifpe.edu.br
SEED_ALUNO_PASSWORD=aluno123
