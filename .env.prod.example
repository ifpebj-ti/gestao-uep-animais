# Copie para ".env" na mesma pasta do docker-compose.prod.yml (na VM), NUNCA
# commite esse arquivo com valores reais. chmod 600 .env
#
# ATENCAO: o .env NAO executa comandos. Gere os segredos antes (ex.: no
# terminal, "openssl rand -hex 24") e cole o resultado aqui.

# Faz "docker compose ..." (sem -f) usar estes arquivos por padrao na VM.
# Linux separa os arquivos com ":" (no Windows seria ";").
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.proxy.yml

# Qual imagem publicada no GHCR usar. Ver tags disponiveis em Packages no
# GitHub ou na tabela abaixo:
#   main            -> ultimo push na main (homologacao)
#   sha-<7 chars>    -> versao exata (ideal para rollback)
#   0.3.0 / 0.3      -> release estavel (tag git vX.Y.Z)
#   latest           -> ultimo release
IMAGE_TAG=main

FRONTEND_PORT=8080
BACKEND_PORT=3000
DATA_SERVICE_PORT=5000

# Dominio publico do sistema (apontar registros A do dominio e de
# api.<dominio> para o IP da VM). O Caddy emite o certificado HTTPS sozinho:
#   https://<dominio>      -> frontend
#   https://api.<dominio>  -> API
APP_DOMAIN=seudominio.exemplo

# URL publica da API, alcancavel pelo NAVEGADOR (nunca localhost em producao)
API_URL=https://api.seudominio.exemplo

# Origem(ns) do frontend liberadas no CORS da API (separe por virgula)
CORS_ORIGINS=https://seudominio.exemplo

# Login com Google — mesmo Client ID do .env.example da raiz; autorize a URL
# publica do frontend (https://<dominio>) em
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=147371043562-666mofd5hhh4paac5hu3umdiptgao07j.apps.googleusercontent.com

# Banco de dados — gere uma senha forte (ex.: openssl rand -hex 24)
DB_NAME=gestao_uep
DB_USER=gestao_uep_app
DB_PASSWORD=

# Auth — gere um segredo forte (ex.: openssl rand -hex 48)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Contas semente — aplicadas SOMENTE na primeira subida (banco vazio).
# Defina senhas fortes ANTES do primeiro "docker compose up"; alterar depois
# nao muda contas ja existentes.
SEED_DEMO_USERS=true
SEED_ADMIN_EMAIL=admin@ifpe.edu.br
SEED_ADMIN_PASSWORD=
SEED_PROFESSOR_EMAIL=professor@ifpe.edu.br
SEED_PROFESSOR_PASSWORD=
SEED_TECNICO_EMAIL=tecnico@ifpe.edu.br
SEED_TECNICO_PASSWORD=
SEED_ESTAGIARIO_EMAIL=estagiario@ifpe.edu.br
SEED_ESTAGIARIO_PASSWORD=
SEED_ALUNO_EMAIL=aluno@ifpe.edu.br
SEED_ALUNO_PASSWORD=